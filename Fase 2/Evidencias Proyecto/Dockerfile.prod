# Imagen de PRODUCCIÓN del backend (FastAPI). El Dockerfile original queda solo para desarrollo.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Las dependencias van primero: Docker reutiliza esta capa mientras requirements.txt no cambie
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# No correr como root dentro del contenedor
RUN useradd --create-home --uid 10001 app && chown -R app /app
USER app

EXPOSE 8000

# Sin --reload. --proxy-headers: toma la IP real del cliente y el esquema https desde las cabeceras
# del proxy de Azure/nginx. Seguro porque este contenedor NO tiene ingress público (solo lo alcanza nginx).
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
